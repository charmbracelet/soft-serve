diff --git a/bar.png b/bar.png
new file mode 100644
index 0000000000000000000000000000000000000000..a226a70db3e220dec6656979d64fd0f20f1fec1d
--- /dev/null
+++ b/bar.png
@@ -0,0 +1,3 @@
